{
  "model_name": "geometric_transformer",
  "model": {
    "hidden_dim": 128,
    "num_heads": 8,
    "transformer_layers": 4,
    "refinement_layers": 3,
    "dropout": 0.1,
    "ffn_multiplier": 4,
    "sigma_distance": 0.5,
    "sigma_angle_degrees": 15.0,
    "angle_k": 4,
    "angle_reduction": "max",
    "distance_cutoff": 8.0,
    "distance_rbf": 24,
    "coordinate_scale": 0.1,
    "movement_gate_bias": -2.0,
    "crop_radius": 12.0
  },
  "graph": {
    "radius": 6.0,
    "max_neighbors": 32,
    "cache_schema_version": 1
  },
  "training": {
    "epochs": 100,
    "batch_size": 2,
    "gradient_accumulation": 4,
    "learning_rate": 0.0001,
    "weight_decay": 0.0001,
    "grad_clip": 1.0,
    "patience": 15,
    "num_workers": 8,
    "seed": 42,
    "amp": true,
    "log_every": 25,
    "local_metric_radius": 8.0,
    "monitor": "loss_total",
    "response_balanced_sampling": false,
    "response_bins": 5,
    "response_sampling_radius": 8.0
  },
  "loss": {
    "coordinate": 1.0,
    "edge_distance": 0.2,
    "clash": 0.02,
    "far_delta": 0.0,
    "frame_rotation": 0.0,
    "frame_translation": 0.0,
    "torsion": 0.0,
    "local_boost": 3.0,
    "local_scale": 6.0,
    "new_atom_boost": 1.0,
    "clash_distance": 1.2,
    "far_radius": 12.0,
    "response_ca": 0.0,
    "mutation_sidechain": 0.0,
    "mr_margin": 0.0,
    "low_response_anchor": 0.0,
    "mr_radius": 8.0,
    "mr_high_threshold": 0.55,
    "mr_low_threshold": 0.32,
    "mr_temperature": 0.05,
    "mr_improvement_fraction": 0.02,
    "mr_hinge_softness": 0.01,
    "anchor_beta": 0.1,
    "response_radius": 8.0,
    "response_boost": 4.0,
    "response_scale": 0.25,
    "response_max_weight": 5.0,
    "response_beta": 0.25,
    "sidechain_beta": 0.25
  },
  "local_radius": 12.0,
  "pair_class": "all"
}
